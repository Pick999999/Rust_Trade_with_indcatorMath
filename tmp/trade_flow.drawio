  <diagram id="trade_flow" name="Trade System Flow">
    <mxGraphModel dx="1422" dy="798" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1653" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="node1" value="&lt;b&gt;[main.rs]&lt;/b&gt;&lt;br&gt;handle_post_trade / auto_schedule_trade&lt;br&gt;&lt;i&gt;รับคำสั่งเริ่มทำงาน (จาก Web หรือ Schedule)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="484" y="40" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="node2" value="&lt;b&gt;[deriv.rs]&lt;/b&gt;&lt;br&gt;start_deriv_bot_multiplexed&lt;br&gt;&lt;i&gt;เตรียมตัวแปรสถานะและเชื่อมต่อ WebSocket&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="484" y="140" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="node3" value="&lt;b&gt;[deriv.rs]&lt;/b&gt;&lt;br&gt;ส่งคำขอผ่าน WS&lt;br&gt;&lt;i&gt;ยืนยันตัวตน (authorize) และขอแท่งเทียนย้อนหลัง (ticks_history)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="484" y="240" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="node4" value="&lt;b&gt;[deriv.rs]&lt;/b&gt;&lt;br&gt;รับข้อมูลจาก WS (candles)&lt;br&gt;&lt;i&gt;แปลงข้อมูลแท่งเทียนย้อนหลัง 1,000 แท่ง&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="484" y="340" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="node5" value="&lt;b&gt;[analysis.rs]&lt;/b&gt;&lt;br&gt;AnalysisEngine::process_history&lt;br&gt;&lt;i&gt;คำนวณ EMA และ ATR รวดเดียวแบบประหยัดพลังงาน (SIMD Batch)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="484" y="440" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="node6" value="&lt;b&gt;[deriv.rs]&lt;/b&gt;&lt;br&gt;รับข้อมูลจาก WS (ohlc)&lt;br&gt;&lt;i&gt;รับข้อมูลราคาสดๆ ทุกๆ 1 วินาที&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="484" y="540" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="node7" value="&lt;b&gt;[analysis.rs]&lt;/b&gt;&lt;br&gt;AnalysisEngine::update_tick&lt;br&gt;&lt;i&gt;คำนวณอินดิเคเตอร์เฉพาะแท่งล่าสุดแบบอัพเดทค่า (O(1))&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="484" y="640" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="node8" value="&lt;b&gt;[deriv.rs]&lt;/b&gt;&lt;br&gt;ขึ้นแท่งเทียนใหม่?&lt;br&gt;และไม่ได้เทรดค้างอยู่?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="484" y="740" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="node9" value="&lt;b&gt;[deriv.rs]&lt;/b&gt;&lt;br&gt;เลยเวลาปิดรอบ?&lt;br&gt;และไม่ได้ติด Martingale?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="484" y="860" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="node21" value="&lt;b&gt;[deriv.rs]&lt;/b&gt;&lt;br&gt;หยุดพักการเทรด&lt;br&gt;&lt;i&gt;รอจนกว่าจะถึงรอบเวลาถัดไป&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="800" y="870" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="node10" value="&lt;b&gt;[deriv.rs]&lt;/b&gt;&lt;br&gt;ตรวจสอบสัญญาณเข้าเทรด&lt;br&gt;&lt;i&gt;ต้องติด Martingale อยู่ หรือมี Spike ในแท่งก่อนหน้า&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="484" y="980" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="node11" value="&lt;b&gt;[deriv.rs]&lt;/b&gt;&lt;br&gt;เข้าเงื่อนไขเทรดหรือไม่?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="484" y="1080" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="node12" value="&lt;b&gt;[get_action.rs]&lt;/b&gt;&lt;br&gt;get_suggest_color&lt;br&gt;&lt;i&gt;หาจุดเข้าเทรด (กด Call/Put) ตามกลยุทธ์ Martingale&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="484" y="1200" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="node13" value="&lt;b&gt;[deriv.rs]&lt;/b&gt;&lt;br&gt;ส่งคำขอผ่าน WS (buy)&lt;br&gt;&lt;i&gt;ยิงคำสั่งซื้อ (Buy Contract)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="484" y="1300" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="node14" value="&lt;b&gt;[deriv.rs]&lt;/b&gt;&lt;br&gt;รับข้อมูลจาก WS (buy)&lt;br&gt;&lt;i&gt;บันทึก contract_id และติดตามสถานะไม้ที่เปิดอยู่&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="484" y="1400" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="node15" value="&lt;b&gt;[deriv.rs]&lt;/b&gt;&lt;br&gt;รับข้อมูลจาก WS (proposal_open_contract)&lt;br&gt;&lt;i&gt;รับสถานะผลกำไรขาดทุนล่าสุดของไม้ที่เทรดอยู่&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="484" y="1500" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="node16" value="&lt;b&gt;[deriv.rs]&lt;/b&gt;&lt;br&gt;ปิดไม้แล้วหรือยัง?&lt;br&gt;&lt;i&gt;is_sold == 1 หรือ status สรุปผลแล้ว&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="484" y="1600" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="node17" value="&lt;b&gt;[deriv.rs]&lt;/b&gt;&lt;br&gt;ชนะ / แพ้ ?&lt;br&gt;&lt;i&gt;กำไร (profit) &amp;gt; 0&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="484" y="1720" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="node18" value="&lt;b&gt;[deriv.rs]&lt;/b&gt;&lt;br&gt;กรณีชนะ (Win)&lt;br&gt;&lt;i&gt;รีเซ็ต loss_con เป็น 0, ล้างสถานะ Martingale&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="304" y="1840" width="200" height="60" as="geometry"/>
